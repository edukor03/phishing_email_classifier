<%- include('./partials/header.ejs') %>

<%- include('./partials/navbar.ejs') %>

<div class="dashboard-container section">
    <h1>Dashboard</h1>
    <div class="dashboard-row">
        <% if (data && data.stats) { %>
            <div class="card">
                <h3 class="card-title">Total Emails</h3>
                <div class="card-content">
                    <p class="card-big-text"><%= data.stats.num_emails %></p>
                </div>
            </div>
            <div class="card">
                <h3 class="card-title">Phishing Emails</h3>
                <div class="card-content">
                    <p class="card-big-text">
                        <%= data.stats.num_phishing %>
                        <span class="positive-highlight card-small-text">
                            (<%= data.stats.phishing_percent %>%)
                        </span>
                    </p>
                </div>
            </div>
            <div class="card">
                <h3 class="card-title">Safe Emails</h3>
                <div class="card-content">
                    <p class="card-big-text">
                        <%= data.stats.num_safe %>
                        <span class="positive-highlight card-small-text">
                            (<%= 100 - data.stats.phishing_percent %>%)
                        </span>
                    </p>
                </div>
            </div>
        <% } else { %>

            <div class="card">
                <h3 class="card-title">No scan yet</h3>
                <div class="card-content">
                    <p class="card-big-text">Upload a CSV to start</p>
                </div>
            </div>

        <% } %>
    </div>
    <div class="dashboard-row">
        <div class="card">
            <h3 class="card-title">Latest Scan Results</h3>
            <div class="card-content">

                <% if (data && data.rows && data.rows.length > 0) { %>

                    <table class="table">
                        <thead>
                            <tr>
                                <th>Email</th>
                                <th>Length</th>
                                <th>Links</th>
                                <th>Caps</th>
                                <th>Prediction</th>
                                <th>Confidence</th>
                                <th>Date</th>
                            </tr>
                        </thead>

                        <tbody>
                            <% data.rows.forEach(r => { %>
                            <tr>
                                <td><%= (r.email || r.text || "").slice(0,60) %>...</td>
                                <td><%= r.length || 0 %></td>
                                <td><%= r.num_links || 0 %></td>
                                <td><%= r.num_caps || 0 %></td>

                                <td class="<%= r.prediction ? 'phish' : 'safe' %>">
                                    <%= r.prediction ? "Phishing" : "Safe" %>
                                </td>

                                <td><%= (r.confidence * 100).toFixed(1) || "0" %>%</td>
                                <td><%= r.date || "N/A" %></td>
                            </tr>
                            <% }) %>
                        </tbody>
                    </table>
                <% } else { %>
                    <p>No scan results yet. Upload a CSV.</p>
                <% } %>

            </div>
        </div>
        <div class="dashboard-column">
            <div class="card">
                <h3 class="card-title">Phishing Common Words</h3>
                <div class="card-content">

                    <% if (data && data.stats && data.stats.top_phishing_words && data.stats.top_phishing_words.length > 0) { %>

                    <ul class="word-list">
                        <% data.stats.top_phishing_words.forEach(w => { %>
                            <li>
                                <span class="word"><%= w.word %></span>
                                <span class="count">(<%= w.count %>)</span>
                            </li>
                        <% }) %>
                    </ul>

                    <% } else { %>
                        <p>No phishing keywords yet.</p>
                    <% } %>

                </div>
            </div>


            <div class="card">
                <h3 class="card-title">Safe Common Words</h3>
                <div class="card-content">

                    <% if (data && data.stats && data.stats.top_safe_words && data.stats.top_safe_words.length > 0) { %>

                    <ul class="word-list">
                        <% data.stats.top_safe_words.forEach(w => { %>
                            <li>
                                <span class="word"><%= w.word %></span>
                                <span class="count">(<%= w.count %>)</span>
                            </li>
                        <% }) %>
                    </ul>

                    <% } else { %>
                        <p>No safe keywords yet.</p>
                    <% } %>
                </div>
            </div>
        </div>
    </div>
</div>

<%- include('./partials/footer.ejs') %>