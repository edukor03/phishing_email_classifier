<%- include('./partials/header.ejs') %>
<%- include('./partials/navbar.ejs') %>

<div class="content">
    <div class="dashboard-container section">
        <h1>Dashboard</h1>

        <% const stats = data?.stats || {}; %>

        <div class="dashboard-row">
            <div class="card dashboard-card-fixed">
                <h3 class="card-title">Total Emails</h3>
                <p class="card-big-text"><%= stats.num_emails || 0 %></p>
            </div>

            <div class="card dashboard-card-fixed">
                <h3 class="card-title">Phishing Emails</h3>
                <p class="card-big-text">
                    <%= stats.num_phishing || 0 %>
                    <span class="card-small-text">
                        (<%= stats.phishing_percent || 0 %>%)
                    </span>
                </p>
            </div>

            <div class="card dashboard-card-fixed">
                <h3 class="card-title">Safe Emails</h3>
                <p class="card-big-text">
                    <%= stats.num_safe || 0 %>
                    <span class="card-small-text">
                        (<%= (stats.phishing_percent ? 100 - stats.phishing_percent : 0) %>%)
                    </span>
                </p>
            </div>
        </div>

        <div class="dashboard-row">
            <div class="card dashboard-card-expand">
                <h3 class="card-title">Latest Scan Results</h3>

                <% if (data?.rows?.length > 0) { %>

                    <table class="table">
                        <thead>
                            <tr>
                                <th>Email</th>
                                <th>Length</th>
                                <th>Links</th>
                                <th>Caps</th>
                                <th>Prediction</th>
                                <th>Confidence</th>
                                <th>Date</th>
                            </tr>
                        </thead>

                        <tbody>
                            <% data.rows.forEach(r => { %>
                            <tr>
                                <td><%= (r.email_text || '').slice(0,60) %>...</td>
                                <td><%= r.length || 0 %></td>
                                <td><%= r.num_links || 0 %></td>
                                <td><%= r.num_caps || 0 %></td>
                                <td class="<%= r.prediction ? 'phish' : 'safe' %>">
                                    <%= r.prediction ? 'Phishing' : 'Safe' %>
                                </td>
                                <td><%= ((r.confidence || 0) * 100).toFixed(1) %>%</td>
                                <td><%= r.date || 'N/A' %></td>
                            </tr>
                            <% }) %>
                        </tbody>
                    </table>

                    <% if (data.pagination.totalPages > 1) { %>
                    <div class="pagination">
                        <% for (let i = 1; i <= data.pagination.totalPages; i++) { %>
                            <% if (i === data.pagination.page) { %>
                                <span class="page current"><%= i %></span>
                            <% } else { %>
                                <a class="page" href="/?page=<%= i %>"><%= i %></a>
                            <% } %>
                        <% } %>
                    </div>
                    <% } %>

                <% } else { %>
                    <p>Import data to view statistics</p>
                <% } %>
            </div>

            <% const wordsPhish = stats.top_phishing_words || []; %>
            <% const wordsSafe = stats.top_safe_words || []; %>

            <div class="dashboard-column">

                <div class="card dashboard-card-fixed">
                    <h3 class="card-title">Phishing Common Words</h3>
                    <% if (wordsPhish.length) { %>
                        <ul class="word-list">
                            <% wordsPhish.forEach(w => { %>
                                <li><%= w.word %> (<%= w.count %>)</li>
                            <% }) %>
                        </ul>
                    <% } else { %>
                        <p>Import data to view statistics</p>
                    <% } %>
                </div>

                <div class="card dashboard-card-fixed">
                    <h3 class="card-title">Safe Common Words</h3>
                    <% if (wordsSafe.length) { %>
                        <ul class="word-list">
                            <% wordsSafe.forEach(w => { %>
                                <li><%= w.word %> (<%= w.count %>)</li>
                            <% }) %>
                        </ul>
                    <% } else { %>
                        <p>Import data to view statistics</p>
                    <% } %>
                </div>

            </div>
        </div>
    </div>
</div>

<%- include('./partials/footer.ejs') %>
